# Токен бота Telegram, полученный у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Публичный HTTPS URL вашего веб-приложения (например, через ngrok или собственный домен)
WEBAPP_URL=https://your-domain.com

# Telegram Chat ID администратора для получения уведомлений о новых заказах
TELEGRAM_ADMIN_CHAT_ID=987654321

# Параметры локального сервера
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
